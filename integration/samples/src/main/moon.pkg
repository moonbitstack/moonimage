// The conformance harness: it writes files for another implementation to read,
// and lays the pixels of a file it read out on disk.
//
// It is a module of its own, under `integration/`, because the library it checks
// is four backends and only one of them has a file system; a dependency on the
// file system belongs here rather than in the library's manifest.

pkgtype(kind: "executable")

import {
  "moonbitstack/moonimage",
  "moonbitstack/moonimage/exr",
  "moonbitstack/moonimage/farbfeld",
  "moonbitstack/moonimage/pnm",
  "moonbitstack/moonimage/tiff",
  "moonbitstack/moonimage/webp",
  "moonbitstack/moonimage/dds",
  "moonbitlang/x/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/debug",
}
