# `.gitignore` keeps `!.git*` so that .gitignore, .github and .gitattributes stay
# tracked; that same negation would otherwise pull the whole `.git` directory —
# object database included — into the published tarball.
.git/
_build/
target/
docs/
scripts/

# The harness module and the workspace manifest that resolves it to this tree are
# for the conformance check in CI: a caller downloads the library, not a rig.
integration/
moon.work
