///|
/// The weight a pixel's index stands for, of sixty-four.
///
/// Three tables rather than one because the number of steps a block can name
/// depends on its mode: two bits give four positions, three give eight, four
/// give sixteen — and the middle of each is not a multiple of the same fraction,
/// so they are tabulated rather than computed.
let weights_two : FixedArray[Int32] = [0, 21, 43, 64]

///|
let weights_three : FixedArray[Int32] = [0, 9, 18, 27, 37, 46, 55, 64]

///|
let weights_four : FixedArray[Int32] = [
  0, 4, 9, 13, 17, 21, 26, 30, 34, 38, 43, 47, 51, 55, 60, 64,
]
