///|
fn adst4(c : FixedArray[Int32], in_at : Int32, in_s : Int32, out_at : Int32, out_s : Int32, min : Int32, max : Int32) -> Unit {
  let in0 : Int32 = c[in_at + (0 * in_s)]
  let in1 : Int32 = c[in_at + (1 * in_s)]
  let in2 : Int32 = c[in_at + (2 * in_s)]
  let in3 : Int32 = c[in_at + (3 * in_s)]
  c[out_at + (0 * out_s)] = (( 1321         * in0 + (3803 - 4096) * in2 + (2482 - 4096) * in3 + (3344 - 4096) * in1 + 2048) >> 12) + in2 + in3 + in1
  c[out_at + (1 * out_s)] = (((2482 - 4096) * in0 -  1321         * in2 - (3803 - 4096) * in3 + (3344 - 4096) * in1 + 2048) >> 12) + in0 - in3 + in1
  c[out_at + (2 * out_s)] = (209 * (in0 - in2 + in3) + 128) >> 8
  c[out_at + (3 * out_s)] = (((3803 - 4096) * in0 + (2482 - 4096) * in2 - 1321         * in3 - (3344 - 4096) * in1 + 2048) >> 12) + in0 + in2 - in1
}

///|
fn adst8(c : FixedArray[Int32], in_at : Int32, in_s : Int32, out_at : Int32, out_s : Int32, min : Int32, max : Int32) -> Unit {
  let in0 : Int32 = c[in_at + (0 * in_s)]
  let in1 : Int32 = c[in_at + (1 * in_s)]
  let in2 : Int32 = c[in_at + (2 * in_s)]
  let in3 : Int32 = c[in_at + (3 * in_s)]
  let in4 : Int32 = c[in_at + (4 * in_s)]
  let in5 : Int32 = c[in_at + (5 * in_s)]
  let in6 : Int32 = c[in_at + (6 * in_s)]
  let in7 : Int32 = c[in_at + (7 * in_s)]
  let t0a : Int32 = (((4076 - 4096) * in7 +   401         * in0 + 2048) >> 12) + in7
  let t1a : Int32 = ((  401         * in7 - (4076 - 4096) * in0 + 2048) >> 12) - in0
  let t2a : Int32 = (((3612 - 4096) * in5 +  1931         * in2 + 2048) >> 12) + in5
  let t3a : Int32 = (( 1931         * in5 - (3612 - 4096) * in2 + 2048) >> 12) - in2
  let mut t4a : Int32 = ( 1299         * in3 +  1583         * in4 + 1024) >> 11
  let mut t5a : Int32 = ( 1583         * in3 -  1299         * in4 + 1024) >> 11
  let mut t6a : Int32 = (( 1189         * in1 + (3920 - 4096) * in6 + 2048) >> 12) + in6
  let mut t7a : Int32 = (((3920 - 4096) * in1 -  1189         * in6 + 2048) >> 12) + in1
  let t0 : Int32 = clip(t0a + t4a, min, max)
  let t1 : Int32 = clip(t1a + t5a, min, max)
  let mut t2 : Int32 = clip(t2a + t6a, min, max)
  let mut t3 : Int32 = clip(t3a + t7a, min, max)
  let t4 : Int32 = clip(t0a - t4a, min, max)
  let t5 : Int32 = clip(t1a - t5a, min, max)
  let mut t6 : Int32 = clip(t2a - t6a, min, max)
  let mut t7 : Int32 = clip(t3a - t7a, min, max)
  t4a = (((3784 - 4096) * t4 +  1567         * t5 + 2048) >> 12) + t4
  t5a = (( 1567         * t4 - (3784 - 4096) * t5 + 2048) >> 12) - t5
  t6a = (((3784 - 4096) * t7 -  1567         * t6 + 2048) >> 12) + t7
  t7a = (( 1567         * t7 + (3784 - 4096) * t6 + 2048) >> 12) + t6
  c[out_at + (0 * out_s)] =  clip(t0  + t2 , min, max)
  c[out_at + (7 * out_s)] = -clip(t1  + t3 , min, max)
  t2             =  clip(t0  - t2 , min, max)
  t3             =  clip(t1  - t3 , min, max)
  c[out_at + (1 * out_s)] = -clip(t4a + t6a, min, max)
  c[out_at + (6 * out_s)] =  clip(t5a + t7a, min, max)
  t6             =  clip(t4a - t6a, min, max)
  t7             =  clip(t5a - t7a, min, max)
  c[out_at + (3 * out_s)] = -(((t2 + t3) * 181 + 128) >> 8)
  c[out_at + (4 * out_s)] =   ((t2 - t3) * 181 + 128) >> 8
  c[out_at + (2 * out_s)] =   ((t6 + t7) * 181 + 128) >> 8
  c[out_at + (5 * out_s)] = -(((t6 - t7) * 181 + 128) >> 8)
}

///|
fn adst16(c : FixedArray[Int32], in_at : Int32, in_s : Int32, out_at : Int32, out_s : Int32, min : Int32, max : Int32) -> Unit {
  let in0 : Int32 = c[in_at + ( 0 * in_s)]
  let in1 : Int32 = c[in_at + ( 1 * in_s)]
  let in2 : Int32 = c[in_at + ( 2 * in_s)]
  let in3 : Int32 = c[in_at + ( 3 * in_s)]
  let in4 : Int32 = c[in_at + ( 4 * in_s)]
  let in5 : Int32 = c[in_at + ( 5 * in_s)]
  let in6 : Int32 = c[in_at + ( 6 * in_s)]
  let in7 : Int32 = c[in_at + ( 7 * in_s)]
  let in8 : Int32 = c[in_at + ( 8 * in_s)]
  let in9 : Int32 = c[in_at + ( 9 * in_s)]
  let in10 : Int32 = c[in_at + (10 * in_s)]
  let in11 : Int32 = c[in_at + (11 * in_s)]
  let in12 : Int32 = c[in_at + (12 * in_s)]
  let in13 : Int32 = c[in_at + (13 * in_s)]
  let in14 : Int32 = c[in_at + (14 * in_s)]
  let in15 : Int32 = c[in_at + (15 * in_s)]
  let mut t0 : Int32 = ((in15 * (4091 - 4096) + in0  *   201         + 2048) >> 12) + in15
  let mut t1 : Int32 = ((in15 *   201         - in0  * (4091 - 4096) + 2048) >> 12) - in0
  let mut t2 : Int32 = ((in13 * (3973 - 4096) + in2  *   995         + 2048) >> 12) + in13
  let mut t3 : Int32 = ((in13 *   995         - in2  * (3973 - 4096) + 2048) >> 12) - in2
  let mut t4 : Int32 = ((in11 * (3703 - 4096) + in4  *  1751         + 2048) >> 12) + in11
  let mut t5 : Int32 = ((in11 *  1751         - in4  * (3703 - 4096) + 2048) >> 12) - in4
  let mut t6 : Int32 = (in9  *  1645         + in6  *  1220         + 1024) >> 11
  let mut t7 : Int32 = (in9  *  1220         - in6  *  1645         + 1024) >> 11
  let mut t8 : Int32 = ((in7  *  2751         + in8  * (3035 - 4096) + 2048) >> 12) + in8
  let mut t9 : Int32 = ((in7  * (3035 - 4096) - in8  *  2751         + 2048) >> 12) + in7
  let mut t10 : Int32 = ((in5  *  2106         + in10 * (3513 - 4096) + 2048) >> 12) + in10
  let mut t11 : Int32 = ((in5  * (3513 - 4096) - in10 *  2106         + 2048) >> 12) + in5
  let mut t12 : Int32 = ((in3  *  1380         + in12 * (3857 - 4096) + 2048) >> 12) + in12
  let mut t13 : Int32 = ((in3  * (3857 - 4096) - in12 *  1380         + 2048) >> 12) + in3
  let mut t14 : Int32 = ((in1  *   601         + in14 * (4052 - 4096) + 2048) >> 12) + in14
  let mut t15 : Int32 = ((in1  * (4052 - 4096) - in14 *   601         + 2048) >> 12) + in1
  let t0a : Int32 = clip(t0 + t8 , min, max)
  let t1a : Int32 = clip(t1 + t9 , min, max)
  let mut t2a : Int32 = clip(t2 + t10, min, max)
  let mut t3a : Int32 = clip(t3 + t11, min, max)
  let mut t4a : Int32 = clip(t4 + t12, min, max)
  let mut t5a : Int32 = clip(t5 + t13, min, max)
  let mut t6a : Int32 = clip(t6 + t14, min, max)
  let mut t7a : Int32 = clip(t7 + t15, min, max)
  let mut t8a : Int32 = clip(t0 - t8 , min, max)
  let mut t9a : Int32 = clip(t1 - t9 , min, max)
  let mut t10a : Int32 = clip(t2 - t10, min, max)
  let mut t11a : Int32 = clip(t3 - t11, min, max)
  let mut t12a : Int32 = clip(t4 - t12, min, max)
  let mut t13a : Int32 = clip(t5 - t13, min, max)
  let mut t14a : Int32 = clip(t6 - t14, min, max)
  let mut t15a : Int32 = clip(t7 - t15, min, max)
  t8   = ((t8a  * (4017 - 4096) + t9a  *   799         + 2048) >> 12) + t8a
  t9   = ((t8a  *   799         - t9a  * (4017 - 4096) + 2048) >> 12) - t9a
  t10  = ((t10a *  2276         + t11a * (3406 - 4096) + 2048) >> 12) + t11a
  t11  = ((t10a * (3406 - 4096) - t11a *  2276         + 2048) >> 12) + t10a
  t12  = ((t13a * (4017 - 4096) - t12a *   799         + 2048) >> 12) + t13a
  t13  = ((t13a *   799         + t12a * (4017 - 4096) + 2048) >> 12) + t12a
  t14  = ((t15a *  2276         - t14a * (3406 - 4096) + 2048) >> 12) - t14a
  t15  = ((t15a * (3406 - 4096) + t14a *  2276         + 2048) >> 12) + t15a
  t0   = clip(t0a + t4a, min, max)
  t1   = clip(t1a + t5a, min, max)
  t2   = clip(t2a + t6a, min, max)
  t3   = clip(t3a + t7a, min, max)
  t4   = clip(t0a - t4a, min, max)
  t5   = clip(t1a - t5a, min, max)
  t6   = clip(t2a - t6a, min, max)
  t7   = clip(t3a - t7a, min, max)
  t8a  = clip(t8  + t12, min, max)
  t9a  = clip(t9  + t13, min, max)
  t10a = clip(t10 + t14, min, max)
  t11a = clip(t11 + t15, min, max)
  t12a = clip(t8  - t12, min, max)
  t13a = clip(t9  - t13, min, max)
  t14a = clip(t10 - t14, min, max)
  t15a = clip(t11 - t15, min, max)
  t4a  = ((t4   * (3784 - 4096) + t5   *  1567         + 2048) >> 12) + t4
  t5a  = ((t4   *  1567         - t5   * (3784 - 4096) + 2048) >> 12) - t5
  t6a  = ((t7   * (3784 - 4096) - t6   *  1567         + 2048) >> 12) + t7
  t7a  = ((t7   *  1567         + t6   * (3784 - 4096) + 2048) >> 12) + t6
  t12  = ((t12a * (3784 - 4096) + t13a *  1567         + 2048) >> 12) + t12a
  t13  = ((t12a *  1567         - t13a * (3784 - 4096) + 2048) >> 12) - t13a
  t14  = ((t15a * (3784 - 4096) - t14a *  1567         + 2048) >> 12) + t15a
  t15  = ((t15a *  1567         + t14a * (3784 - 4096) + 2048) >> 12) + t14a
  c[out_at + ( 0 * out_s)] =  clip(t0  + t2  , min, max)
  c[out_at + (15 * out_s)] = -clip(t1  + t3  , min, max)
  t2a             =  clip(t0  - t2  , min, max)
  t3a             =  clip(t1  - t3  , min, max)
  c[out_at + ( 3 * out_s)] = -clip(t4a + t6a , min, max)
  c[out_at + (12 * out_s)] =  clip(t5a + t7a , min, max)
  t6              =  clip(t4a - t6a , min, max)
  t7              =  clip(t5a - t7a , min, max)
  c[out_at + ( 1 * out_s)] = -clip(t8a + t10a, min, max)
  c[out_at + (14 * out_s)] =  clip(t9a + t11a, min, max)
  t10             =  clip(t8a - t10a, min, max)
  t11             =  clip(t9a - t11a, min, max)
  c[out_at + ( 2 * out_s)] =  clip(t12 + t14 , min, max)
  c[out_at + (13 * out_s)] = -clip(t13 + t15 , min, max)
  t14a            =  clip(t12 - t14 , min, max)
  t15a            =  clip(t13 - t15 , min, max)
  c[out_at + ( 7 * out_s)] = -(((t2a  + t3a)  * 181 + 128) >> 8)
  c[out_at + ( 8 * out_s)] =   ((t2a  - t3a)  * 181 + 128) >> 8
  c[out_at + ( 4 * out_s)] =   ((t6   + t7)   * 181 + 128) >> 8
  c[out_at + (11 * out_s)] = -(((t6   - t7)   * 181 + 128) >> 8)
  c[out_at + ( 6 * out_s)] =   ((t10  + t11)  * 181 + 128) >> 8
  c[out_at + ( 9 * out_s)] = -(((t10  - t11)  * 181 + 128) >> 8)
  c[out_at + ( 5 * out_s)] = -(((t14a + t15a) * 181 + 128) >> 8)
  c[out_at + (10 * out_s)] =   ((t14a - t15a) * 181 + 128) >> 8
}

///|
fn identity4(c : FixedArray[Int32], at : Int32, stride : Int32) -> Unit {
  for i in 0..<4 {
  let sample : Int32 = c[at + (stride * i)]
  c[at + (stride * i)] = sample + ((sample * 1697 + 2048) >> 12)
  }
}

///|
fn identity8(c : FixedArray[Int32], at : Int32, stride : Int32) -> Unit {
  for i in 0..<8 {
  c[at + (stride * i)] = c[at + (stride * i)] * 2
  }
}

///|
fn identity16(c : FixedArray[Int32], at : Int32, stride : Int32) -> Unit {
  for i in 0..<16 {
  let sample : Int32 = c[at + (stride * i)]
  c[at + (stride * i)] = 2 * sample + ((sample * 1697 + 1024) >> 11)
  }
}

///|
fn identity32(c : FixedArray[Int32], at : Int32, stride : Int32) -> Unit {
  for i in 0..<32 {
  c[at + (stride * i)] = c[at + (stride * i)] * 4
  }
}

///|
fn wht4(c : FixedArray[Int32], at : Int32, stride : Int32) -> Unit {
  let in0 : Int32 = c[at + (0 * stride)]
  let in1 : Int32 = c[at + (1 * stride)]
  let in2 : Int32 = c[at + (2 * stride)]
  let in3 : Int32 = c[at + (3 * stride)]
  let t0 : Int32 = in0 + in1
  let t2 : Int32 = in2 - in3
  let t4 : Int32 = (t0 - t2) >> 1
  let t3 : Int32 = t4 - in3
  let t1 : Int32 = t4 - in1
  c[at + (0 * stride)] = t0 - t3
  c[at + (1 * stride)] = t3
  c[at + (2 * stride)] = t1
  c[at + (3 * stride)] = t2 + t1
}
