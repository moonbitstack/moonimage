///|
fn clip(value : Int32, min : Int32, max : Int32) -> Int32 {
  if value < min {
    min
  } else if value > max {
    max
  } else {
    value
  }
}

///|
fn dct4(c : FixedArray[Int32], at : Int32, stride : Int32, min : Int32, max : Int32, tx64 : Bool) -> Unit {
  let in0 : Int32 = c[at + (0 * stride)]
  let in1 : Int32 = c[at + (1 * stride)]
  let mut t0 : Int32 = 0
  let mut t1 : Int32 = 0
  let mut t2 : Int32 = 0
  let mut t3 : Int32 = 0
  if tx64 {
  t1 = (in0 * 181 + 128) >> 8
  t0 = t1
  t2 = (in1 * 1567 + 2048) >> 12
  t3 = (in1 * 3784 + 2048) >> 12
  } else {
  let in2 : Int32 = c[at + (2 * stride)]
  let in3 : Int32 = c[at + (3 * stride)]
  t0 = ((in0 + in2) * 181 + 128) >> 8
  t1 = ((in0 - in2) * 181 + 128) >> 8
  t2 = ((in1 *  1567         - in3 * (3784 - 4096) + 2048) >> 12) - in3
  t3 = ((in1 * (3784 - 4096) + in3 *  1567         + 2048) >> 12) + in1
  }
  c[at + (0 * stride)] = clip(t0 + t3, min, max)
  c[at + (1 * stride)] = clip(t1 + t2, min, max)
  c[at + (2 * stride)] = clip(t1 - t2, min, max)
  c[at + (3 * stride)] = clip(t0 - t3, min, max)
}

///|
fn dct8(c : FixedArray[Int32], at : Int32, stride : Int32, min : Int32, max : Int32, tx64 : Bool) -> Unit {
