///|
fn dct64(c : FixedArray[Int32], at : Int32, stride : Int32, min : Int32, max : Int32) -> Unit {
  dct32(c, at, stride << 1, min, max, true)
  let in1 : Int32 = c[at + ( 1 * stride)]
  let in3 : Int32 = c[at + ( 3 * stride)]
