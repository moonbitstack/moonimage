  t4a = (in1 *   799 + 2048) >> 12
  t5a = (in3 * -2276 + 2048) >> 12
  t6a = (in3 *  3406 + 2048) >> 12
  t7a = (in1 *  4017 + 2048) >> 12
  } else {
  let in5 : Int32 = c[at + (5 * stride)]
  let in7 : Int32 = c[at + (7 * stride)]
  t4a = ((in1 *   799         - in7 * (4017 - 4096) + 2048) >> 12) - in7
  t5a =  (in5 *  1703         - in3 *  1138         + 1024) >> 11
  t6a =  (in5 *  1138         + in3 *  1703         + 1024) >> 11
  t7a = ((in1 * (4017 - 4096) + in7 *  799          + 2048) >> 12) + in1
  }
  let t4 : Int32 = clip(t4a + t5a, min, max)
  t5a = clip(t4a - t5a, min, max)
  let t7 : Int32 = clip(t7a + t6a, min, max)
  t6a = clip(t7a - t6a, min, max)
  let t5 : Int32 = ((t6a - t5a) * 181 + 128) >> 8
  let t6 : Int32 = ((t6a + t5a) * 181 + 128) >> 8
  let t0 : Int32 = c[at + (0 * stride)]
  let t1 : Int32 = c[at + (2 * stride)]
  let t2 : Int32 = c[at + (4 * stride)]
  let t3 : Int32 = c[at + (6 * stride)]
  c[at + (0 * stride)] = clip(t0 + t7, min, max)
  c[at + (1 * stride)] = clip(t1 + t6, min, max)
  c[at + (2 * stride)] = clip(t2 + t5, min, max)
  c[at + (3 * stride)] = clip(t3 + t4, min, max)
  c[at + (4 * stride)] = clip(t3 - t4, min, max)
  c[at + (5 * stride)] = clip(t2 - t5, min, max)
  c[at + (6 * stride)] = clip(t1 - t6, min, max)
  c[at + (7 * stride)] = clip(t0 - t7, min, max)
}

