name = "moonbitstack/moonimage"

version = "0.1.4"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonimage"

license = "Apache-2.0"

keywords = [
  "image",
  "images",
  "image-codec",
  "codec",
  "codecs",
  "png",
  "apng",
  "jpeg",
  "jpg",
  "progressive-jpeg",
  "exif",
  "icc",
  "gif",
  "webp",
  "qoi",
  "bmp",
  "tga",
  "tiff",
  "lzw",
  "packbits",
  "bigtiff",
  "ico",
  "cur",
  "icon",
  "cursor",
  "pnm",
  "pbm",
  "pgm",
  "ppm",
  "pam",
  "netpbm",
  "hdr",
  "radiance",
  "rgbe",
  "exr",
  "openexr",
  "half-float",
  "float-image",
  "farbfeld",
  "dds",
  "bc1",
  "bc3",
  "bc5",
  "bc6h",
  "bc7",
  "bptc",
  "dxt",
  "decode",
  "encode",
  "transcode",
  "convert",
  "raster",
  "pixel",
  "pixels",
  "rgba",
  "resize",
  "scale",
  "resample",
  "lanczos",
  "bilinear",
  "catmull-rom",
  "gaussian",
  "blur",
  "sharpen",
  "unsharp-mask",
  "crop",
  "rotate",
  "flip",
  "premultiplied",
  "alpha",
  "animation",
  "metadata",
  "thumbnail",
  "texture",
  "moonbit",
]

description = "Image codecs for MoonBit: PNG, JPEG, GIF, WebP, BMP, TGA, QOI, TIFF, ICO, PNM, Radiance HDR, OpenEXR, farbfeld and DDS, read and written, with the pixel arithmetic, filters and colour between them."

source = "src"

import {
  "moonbitstack/moonzip@0.3.8",
  "moonbitstack/moonrgba@0.1.3",
  "moonbitlang/x@0.5.7",
}
